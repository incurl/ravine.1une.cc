.cache/
# We track specific files in .vscode/ (the IDE config we ship to all
# contributors) and leave the rest untracked (per-user launch configs,
# snippets, keybindings, etc.). The pattern below ignores *everything*
# in .vscode/ and then re-includes the four shared files. The `!/` in
# the negation patterns is required: without it, the negation would
# be relative-to-anywhere and could be defeated by another rule.
#
# If you add a new shared file to .vscode/, add its name below.
.vscode/*
!/.vscode/tasks.json
!/.vscode/settings.json
!/.vscode/extensions.json
!/.vscode/c_cpp_properties.json
.idea/

# python
__pycache__/
*.pyc

# Vendored AMY sources (fetch with components/amy/README.md instructions)
components/amy/src/

# In-progress / untracked work that isn't part of the firmware release yet.
# These are kept on disk for reference but should not be committed without
# explicit intent. Remove these lines if/when the work lands.
#
#   docs/Make_Electronic_Music.md
#   docs/Music_Theory_for_Computer_Musicians.md
#   docs/Music_Theory_for_Electronic_Music_Pro.md
#             Third-party scanned book content (visible COURSE TECHNOLOGY
#             watermarks). Reference material, not firmware project docs.
docs/Make_Electronic_Music.md
docs/Music_Theory_for_Computer_Musicians.md
docs/Music_Theory_for_Electronic_Music_Pro.md

# Accidental build artifacts: an unexpanded ${sourceDir} shell variable in an
# idf.py/cmake invocation creates a literal directory with that name.
${sourceDir}/

# Host simulator build output and its emulated flash storage.
build-sim/
sim_flash/
