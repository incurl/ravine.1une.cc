{
  "configurations": [
    {
      "name": "ESP-IDF v6.1 (ESP32-S3)",
      "compileCommands": "${workspaceFolder}/build/compile_commands.json",
      "compilerPath": "${default}",
      "cStandard": "c11",
      "cppStandard": "c++17",
      "intelliSenseMode": "${default}",
      "configurationProvider": "ms-vscode.cmake-tools",
      "forcedInclude": [
        "${workspaceFolder}/build/config/sdkconfig.h"
      ],
      "includePath": [
        "${workspaceFolder}/main",
        "${workspaceFolder}/main/audio",
        "${workspaceFolder}/main/ui",
        "${workspaceFolder}/main/system",
        "${workspaceFolder}/main/storage",
        "${workspaceFolder}/main/sequencer",
        "${workspaceFolder}/main/sketch",
        "${workspaceFolder}/components/amy/include",
        "${workspaceFolder}/components/amy",
        "${workspaceFolder}/build/config",
        "${env:IDF_PATH}/components",
        "${env:IDF_PATH}/components/esp_hw_support/include",
        "${env:IDF_PATH}/components/freertos/FreeRTOS-Kernel/include",
        "${env:IDF_PATH}/components/freertos/FreeRTOS-Kernel/portable/xtensa/include",
        "${env:IDF_PATH}/components/newlib/platform_include",
        "${env:IDF_PATH}/components/soc/esp32s3/include",
        "${env:IDF_PATH}/components/esp_common/include",
        "${env:IDF_PATH}/components/esp_hw_support/dma/include",
        "${env:IDF_PATH}/components/esp_timer/include",
        "${env:IDF_PATH}/components/esp_driver_gpio/include",
        "${env:IDF_PATH}/components/esp_driver_ledc/include",
        "${env:IDF_PATH}/components/esp_driver_pcnt/include",
        "${env:IDF_PATH}/components/esp_adc/include",
        "${env:IDF_PATH}/components/driver/include",
        "${env:IDF_PATH}/components/esp_lcd/include",
        "${env:IDF_PATH}/components/esp_lcd_ili9341/include",
        "${env:IDF_PATH}/components/nvs_flash/include",
        "${env:IDF_PATH}/components/littlefs/include"
      ],
      "browse": {
        "limitSymbolsToIncludedHeaders": false,
        "databaseFilename": "${workspaceFolder}/.vscode/browse.VC.db",
        "path": [
          "${workspaceFolder}",
          "${env:IDF_PATH}/components"
        ]
      },
      "windows": {
        "compilerPath": "C:/Users/${env:USERNAME}/.espressif/v6.1/esp-idf/tools/tools/xtensa-esp-elf/esp-13.2.0/xtensa-esp-elf/bin/xtensa-esp32s3-elf-gcc.exe"
      },
      "linux": {
        "compilerPath": "/usr/bin/gcc"
      },
      "osx": {
        "compilerPath": "/usr/bin/clang"
      },
      "mac": {
        "compilerPath": "/usr/bin/clang"
      },
      "comment": [
        "The compile_commands.json file is regenerated by every idf.py build, so",
        "MS IntelliSense picks up new sources / flags automatically. The explicit",
        "includePath above is a fallback for when build/ does not yet exist (first",
        "checkout, before the first build). The first time you open this project:",
        "1. Run the 'Build firmware' task once to populate build/compile_commands.json.",
        "2. Then 'C/C++: Reset IntelliSense Database' (Ctrl+Shift+P)."
      ]
    }
  ],
  "version": 4
}
